# Copy to eval/.env (gitignored) and fill in. Never commit real values.

# The only paid service the benchmark needs: OpenAI, for every LLM call
# (dataset text, extraction, answering, judging). The two local rankers
# (bge_m3, bge_m3_reranker) run on this machine and cost nothing.
EVAL_GATEWAY=openai
OPENAI_API_KEY=sk-...

# Hard cap on hosted spend per command (default 150). A command that reaches it
# stops and resumes from the response cache when rerun, so start low.
EVAL_MAX_SPEND_USD=10

# Neon "eval" branch, DIRECT connection string (host without "-pooler").
# SQLAlchemy/psycopg3 form, with TLS required. Not needed with `--store memory`.
EVAL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Optional model overrides (OpenAI defaults shown). gpt-6-luna is about ten
# times cheaper than gpt-6.1-terra for the generator and the judge.
# EVAL_GEN_MODEL=gpt-6.1-terra
# EVAL_SUMMARY_MODEL=gpt-5-nano
# EVAL_SYSTEM_MODEL=gpt-5-nano
# EVAL_JUDGE_MODEL=gpt-6.1-terra

# The Jev rankers (bge_m3_jev, jev_full_pool) are not on OpenAI: they need a
# router, billed separately, whose one key then covers Jev and every LLM call
# (model ids there are spelled "openai/gpt-5-nano", "anthropic/claude-sonnet-5.5").
# EVAL_GATEWAY=openrouter
# OPENROUTER_API_KEY=sk-or-...
# EVAL_GATEWAY=vercel
# AI_GATEWAY_API_KEY=...
# EVAL_JEV_MODEL=typesafe/jev-1.14
