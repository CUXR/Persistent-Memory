{
  "description": "Set the owner's glasses display mode: nothing, name, or name_and_facts.",
  "request": {
    "method": "PUT",
    "path": "/briefings/display-mode",
    "headers": {
      "Authorization": "Bearer <token>"
    },
    "body": {
      "display_mode": "name"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "display_mode": "name"
    }
  }
}
