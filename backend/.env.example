# -----------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@host:5432/persistent_memory

# -----------------------------------------------------------------------
# Embeddings (optional — defaults shown)
# -----------------------------------------------------------------------
EMBEDDING_DIMENSION=512
DB_ECHO=false

# -----------------------------------------------------------------------
# OpenAI / LLM (api key required; model and retries are optional)
# -----------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_RETRIES=2

# -----------------------------------------------------------------------
# Memory browser API (frontend integration)
# -----------------------------------------------------------------------
# Local development ONLY. When true, the owner can be chosen with the
# X-User-Id request header, or falls back to the single existing user when no
# header is sent. Leave false anywhere shared; the session middleware from the
# account-creation work sets request.state.user_id instead.
ALLOW_DEV_AUTH_FALLBACK=false
# Browser origins allowed to call the API (comma-separated or a JSON list).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
