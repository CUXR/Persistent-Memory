# -----------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@host:5432/persistent_memory

# -----------------------------------------------------------------------
# Face embeddings (voice vectors are fixed at 512 dimensions)
# -----------------------------------------------------------------------
EMBEDDING_DIMENSION=512
DB_ECHO=false

# -----------------------------------------------------------------------
# OpenAI / LLM (key required for extraction; enrollment/capture need no OpenAI key)
# -----------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2

# Local audio models and retained recordings
HF_TOKEN=hf-...
RECORDING_DIRECTORY=recordings
VOICE_MATCH_THRESHOLD=0.75
VOICE_MATCH_MARGIN=0.15
# Face match: max squared L2 between unit-normalized embeddings (= 2 - 2*cosine)
FACE_MATCH_L2_THRESHOLD=1.0
