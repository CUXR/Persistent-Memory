<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hud_background"
    android:paddingHorizontal="@dimen/hud_padding_horizontal"
    android:paddingVertical="@dimen/hud_padding_vertical">
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/hud_label" android:textColor="@color/hud_accent"
        android:textSize="@dimen/hud_text_small" />
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hud_gap"
        android:textColor="@color/hud_primary" android:textSize="@dimen/hud_text_title"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="@dimen/hud_gap"
        android:textColor="@color/hud_primary" android:textSize="@dimen/hud_text_body"
        android:lineSpacingMultiplier="1.25" />
    <TextView
        android:id="@+id/pageNumber"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/hud_accent" android:textSize="@dimen/hud_text_small" />
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hud_gap"
        android:text="@string/hud_controls" android:textColor="@color/hud_secondary"
        android:textSize="@dimen/hud_text_small" />
</LinearLayout>
